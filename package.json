{
  "name": "padova-open-world",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "node verify-city.mjs && node verify-terrain.mjs && node verify.mjs",
    "audit:map": "node tools/audit-map.mjs",
    "test:modern": "node verify-modern.mjs",
    "audit:modern": "node tools/audit-modern.mjs",
    "dev:legacy": "node tools/serve.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:sim": "node --test tests/*.test.mjs",
    "lint": "eslint src",
    "check": "npm run typecheck && npm run lint && npm run test:sim && npm run test:v2 && npm test && npm run test:modern && npm run audit:map && npm run build",
    "test:v2": "node tools/verify-v2.mjs",
    "prepare:data": "node tools/prepare-v2-data.mjs",
    "predev": "npm run prepare:data",
    "prebuild": "npm run prepare:data",
    "server": "node server/index.mjs",
    "test:load": "node tools/load-test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.67.0"
  }
}
